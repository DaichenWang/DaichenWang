# Unpublished research inputs — do not publish. Regenerate locally with:
#   python3 <skill>/scripts/source_to_md.py <the PDFs and the thesis> -o expanded2026/converted
expanded2026/converted/
expanded2026/projects/*/sources/
expanded2026/assets/

# Derived artefacts, rebuildable from svg_output/ by finalize_svg.py and svg_to_pptx.py
expanded2026/projects/*/svg_final/
expanded2026/projects/*/exports/
expanded2026/projects/*/backup/
expanded2026/projects/*/live_preview/

# Photographs of identifiable people — research participants, the author, and the
# public crowd at Wuxi. Kept out of this public repository; git history cannot be
# cleanly undone, and consent for a conference talk is not consent to publish.
# Restore them locally into projects/*/images/ before rebuilding the decks.
expanded2026/projects/*/images/wuxi_station.jpg
expanded2026/projects/*/images/jichang_fieldwork.jpg
expanded2026/projects/*/images/focusgroup_headset.jpg
expanded2026/projects/*/images/focusgroup_screen.jpg
expanded2026/projects/*/images/scan_lidar_onsite.jpg
expanded2026/incoming/
expanded2026/previews/

# Exported decks embed those photographs
expanded2026/deliverables/*.pptx
